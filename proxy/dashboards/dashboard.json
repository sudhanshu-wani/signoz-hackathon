  "tags": [
    "hackathon",
    "llm-proxy",
    "genai"
  ],
  "title": "LLM Proxy \u2014 AI usage observability (Agents of SigNoz)",
  "version": "v5",
  "widgets": [
    {
      "id": "cost-by-model",
      "panelTypes": "value",
      "query": {
        "builder": {
          "queryData": [
            {
              "aggregations": [
                {
                  "metricName": "llm.cost.usd",
                  "spaceAggregation": "sum",
                  "temporality": "cumulative",
                  "timeAggregation": "increase"
                }
              ],
              "dataSource": "metrics",
              "expression": "A",
              "groupBy": [],
              "having": {
                "expression": ""
              },
              "legend": "",
              "queryName": "A",
              "reduceTo": "sum"
            }
          ],
          "queryFormulas": []
        },
        "queryType": "builder"
      },
      "title": "Cost ($)"
    },
    {
      "id": "requests-by-model",
      "panelTypes": "bar",
      "query": {
        "builder": {
          "queryData": [
            {
              "aggregations": [
                {
                  "metricName": "llm.requests",
                  "spaceAggregation": "sum",
                  "temporality": "cumulative",
                  "timeAggregation": "increase"
                }
              ],
              "dataSource": "metrics",
              "expression": "A",
              "groupBy": [
                {
                  "dataType": "string",
                  "key": "model",
                  "type": "tag"
                }
              ],
              "having": {
                "expression": ""
              },
              "legend": "{{model}}",
              "queryName": "A"
            }
          ],
          "queryFormulas": []
        },
        "queryType": "builder"
      },
      "title": "Requests per minute by model"
    },
    {
      "id": "latency-p95",
      "panelTypes": "graph",
      "query": {
        "builder": {
          "queryData": [
            {
              "aggregations": [
                {
                  "metricName": "llm.request.duration.bucket",
                  "spaceAggregation": "p95",
                  "temporality": null,
                  "timeAggregation": null
                }
              ],
              "dataSource": "metrics",
              "expression": "A",
              "groupBy": [
                {
                  "dataType": "string",
                  "key": "model",
                  "type": "tag"
                }
              ],
              "having": {
                "expression": ""
              },
              "legend": "{{model}}",
              "queryName": "A"
            }
          ],
          "queryFormulas": []
        },
        "queryType": "builder"
      },
      "title": "P95 latency by model (ms)"
    },
    {
      "id": "tokens-by-model",
      "panelTypes": "value",
      "query": {
        "builder": {
          "queryData": [
            {
              "aggregations": [
                {
                  "metricName": "llm.tokens",
                  "spaceAggregation": "sum",
                  "temporality": "cumulative",
                  "timeAggregation": "increase"
                }
              ],
              "dataSource": "metrics",
              "expression": "A",
              "groupBy": [],
              "having": {
                "expression": ""
              },
              "legend": "",
              "queryName": "A",
              "reduceTo": "sum"
            }
          ],
          "queryFormulas": []
        },
        "queryType": "builder"
      },
      "title": "Tokens"
    },
    {
      "id": "error-rate",
      "panelTypes": "bar",
      "query": {
        "builder": {
          "queryData": [
            {
              "aggregations": [
                {
                  "metricName": "llm.requests",
                  "spaceAggregation": "sum",
                  "temporality": "cumulative",
                  "timeAggregation": "increase"
                }
              ],
              "dataSource": "metrics",
              "disabled": true,
              "expression": "A",
              "filter": {
                "expression": "status != '200'"
              },
              "groupBy": [
                {
                  "dataType": "string",
                  "key": "model",
                  "type": "tag"
                }
              ],
              "having": {
                "expression": ""
              },
              "legend": "",
              "queryName": "A"
            },
            {
              "aggregations": [
                {
                  "metricName": "llm.requests",
                  "spaceAggregation": "sum",
                  "temporality": "cumulative",
                  "timeAggregation": "increase"
                }
              ],
              "dataSource": "metrics",
              "disabled": true,
              "expression": "B",
              "groupBy": [
                {
                  "dataType": "string",
                  "key": "model",
                  "type": "tag"
                }
              ],
              "having": {
                "expression": ""
              },
              "legend": "",
              "queryName": "B"
            }
          ],
          "queryFormulas": [
            {
              "expression": "(A/B)*100",
              "legend": "{{model}} error %",
              "queryName": "F1"
            }
          ]
        },
        "queryType": "builder"
      },
      "title": "Error rate % \u2014 is a model failing?"
    },
    {
      "id": "cost-by-feature",
      "panelTypes": "bar",
      "query": {
        "builder": {
          "queryData": [
            {
              "aggregations": [
                {
                  "metricName": "llm.cost.usd",
                  "spaceAggregation": "sum",
                  "temporality": "cumulative",
                  "timeAggregation": "increase"
                }
              ],
              "dataSource": "metrics",
              "disabled": false,
              "expression": "A",
              "groupBy": [
                {
                  "dataType": "string",
                  "key": "feature",
                  "type": "tag"
                }
              ],
              "having": {
                "expression": ""
              },
              "legend": "{{feature}}",
              "queryName": "A"
            }
          ],
          "queryFormulas": []
        },
        "queryType": "builder"
      },
      "title": "Cost by feature \u2014 which feature is burning money?"
    }
  ]
}
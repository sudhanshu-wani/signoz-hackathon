              "dataSource": "metrics",
              "queryName": "A",
              "expression": "A",
              "aggregateOperator": "sum",
              "aggregateAttribute": {
                "key": "llm.tokens",
                "dataType": "float64",
                "type": "Sum"
              },
              "groupBy": [
                {
                  "key": "model",
                  "dataType": "string",
                  "type": "tag"
                }
              ],
              "filters": {
                "op": "AND",
                "items": []
              },
              "legend": "{{model}}"
            }
          ],
          "queryFormulas": []
        }
      }
    }

      "y": 6
    },
    {
      "h": 6,
      "i": "tokens-by-model",
      "moved": false,
      "static": false,
      "w": 6,
      "x": 6,
      "y": 6
    },
    {
      "h": 6,
      "i": "error-rate",
      "moved": false,
      "static": false,
      "w": 6,
      "x": 0,

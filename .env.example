# Copy to .env and fill in. Never commit .env.

# --- LLM provider ---
# ollama (default, free, local, judge-reproducible) or anthropic
LLM_PROVIDER=ollama

# Strong vs cheap tiers for the cost-per-outcome demo.
#   ollama (laptop-friendly): STRONG=qwen2.5:3b  CHEAP=qwen2.5:1.5b
#     alt: STRONG=llama3.2:3b CHEAP=llama3.2:1b ; bigger: qwen2.5:7b vs 3b
#   anthropic: STRONG=claude-sonnet-4-6  CHEAP=claude-haiku-4-5-20251001
STRONG_MODEL=qwen2.5:3b
CHEAP_MODEL=qwen2.5:1.5b

# --- Ollama (local) ---
OLLAMA_HOST=http://localhost:11434

# --- Anthropic (only if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=

# --- SigNoz (self-hosted via Foundry) ---
# OTLP ingestion endpoint of your self-hosted SigNoz otel-collector (gRPC).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=signoz-agents-demo

# SigNoz query/dashboard REST API base.
SIGNOZ_API_URL=http://localhost:8080
# Auth for apply.py — EITHER an API key (Settings -> API keys) ...
SIGNOZ_API_KEY=
# ... OR simply your SigNoz login (created on first visit to the UI):
SIGNOZ_EMAIL=
SIGNOZ_PASSWORD=

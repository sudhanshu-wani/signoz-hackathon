# Copy to .env and edit. Never commit .env.
# Defaults below work out of the box with local Ollama + local SigNoz.

# --- What the proxy forwards to (any OpenAI-compatible API) ---
# Local Ollama (default, free, no key):
UPSTREAM_BASE_URL=http://localhost:11434/v1
UPSTREAM_API_KEY=
#   OpenAI:  UPSTREAM_BASE_URL=https://api.openai.com/v1      + UPSTREAM_API_KEY=sk-...
#   Groq:    UPSTREAM_BASE_URL=https://api.groq.com/openai/v1 + UPSTREAM_API_KEY=...
#   vLLM / LM Studio / Together: any /v1 endpoint works the same way.

# Port the proxy listens on. Your app then points at it:
#   export OPENAI_BASE_URL=http://localhost:8900/v1
PROXY_PORT=8900

# --- Where telemetry goes (self-hosted SigNoz) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=llm-proxy

# --- SigNoz REST API (used by proxy/dashboards/apply.py) ---
SIGNOZ_API_URL=http://localhost:8080
# Auth: EITHER an API key (Settings -> API keys) ...
SIGNOZ_API_KEY=
# ... OR just your SigNoz login (the account created on first visit to the UI):
SIGNOZ_EMAIL=
SIGNOZ_PASSWORD=

# --- Demo traffic generator only (scripts/generate_traffic.py) ---
# Two small local models so the dashboards show a real comparison.
STRONG_MODEL=qwen2.5:3b
MIX_MODEL=llama3.2:1b
